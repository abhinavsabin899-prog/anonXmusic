services:
  - type: web
    name: abhi66
    env: docker
    plan: free


    envVars:
      - key: API_ID
        sync: false

      - key: API_HASH
        sync: false

      - key: BOT_TOKEN
        sync: false

      - key: MONGO_URL
        sync: false

      - key: OWNER_ID
        sync: false

      - key: LOGGER_ID
        sync: false

      - key: SESSION
        sync: false

      - key: PYTHON_VERSION
        value: "3.13.3"
