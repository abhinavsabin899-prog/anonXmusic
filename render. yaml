services:
  - type: web
    name: abhi66
    env: python
    plan: free

    buildCommand: pip3 install --no-cache-dir --upgrade -r requirements.txt
    startCommand: bash start

    envVars:
      - key: API_ID
        sync: false

      - key: API_HASH
        sync: false

      - key: BOT_TOKEN
        sync: false

      - key: MONGO_URL
        sync: false

      - key: OWNER_ID
        sync: false

      - key: LOGGER_ID
        sync: false

      - key: SESSION
        sync: false

      - key: PYTHON_VERSION
        value: "3.13.3"
